# Nix and direnv
/.direnv/
/result
/result-*

# Rust build output
/target/

# Go connector build output
/connectors/telegram/wuphf-telegram
/connectors/whatsapp/wuphf-whatsapp
/connectors/instagram/wuphf-instagram

# Go provider build output
/providers/mediaconv/wuphf-mediaconv

# Dev binaries installed by scripts/install-dev-bins.sh
/scripts/dev-bin/.bin/

# Local runtime state and configuration
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
# Copies set aside, e.g. wuphf.sqlite.backup or wuphf.sqlite.2026-11-23-0311.
*.sqlite.*
/.env
/.env.*
# Every component's own config, which the dev launchers pick over the example.
config.local.toml
*.session.json
*.cookies.json
*.state.json
# A running connector's session lock (`<session>.lock`).
*.db.lock
*.session.json.lock

# Editor and operating system files
.DS_Store
*.swp
*.swo
.idea/
.vscode/

/vendor/
/connectors/whatsapp-rust/target/
