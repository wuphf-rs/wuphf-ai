// Zellij layout for the wuphf dev session, launched by scripts/dev-session.sh.
//
// One tab per component, so each gets the full window: bridge logs are wide and
// noisy, and reading them side by side in split panes means reading none of
// them. Switch with Alt+<number> or Alt+h/l.
//
// Every tab is a plain shell rather than a running process: a bridge is started
// and restarted constantly while developing, and a shell that has just exited a
// crashed connector is more useful than a dead pane. The launcher puts
// scripts/dev-bin on PATH, so each tab starts one component by name
// (wuphf-server, wuphf-telegram, …) with the short aliases from
// scripts/dev-aliases.sh.
//
// Pane cwds are relative to the directory zellij is started in, which the
// launcher sets to the repository root.

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // The server first: it carries the routing logs that explain what the
    // connectors are doing, and it has to be up before they connect.
    tab name="server" focus=true {
        pane name="server"
    }

    // Each connector runs from its own directory, where its session files live.
    tab name="telegram" {
        pane name="telegram" cwd="connectors/telegram"
    }
    tab name="whatsapp" {
        pane name="whatsapp" cwd="connectors/whatsapp"
    }
    tab name="instagram" {
        pane name="instagram" cwd="connectors/instagram"
    }

    // The sticker converter the connectors call through the core.
    tab name="mediaconv" {
        pane name="mediaconv" cwd="providers/mediaconv"
    }

    // Non-bridging features (the Instagram downloader); a client of the core.
    tab name="misc" {
        pane name="misc" cwd="misc"
    }

    tab name="tui" {
        pane name="tui"
    }

    tab name="shell" {
        pane name="shell"
    }
}
