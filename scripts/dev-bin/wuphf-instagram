#!/usr/bin/env bash
# Run the instagram connector from its own directory, where its session and
# config files live. Config comes from $WUPHF_INSTAGRAM_CONFIG, or the checked-in
# example. Any argument switches to passthrough, so subcommands still work.
# Runs the binary scripts/install-dev-bins.sh installed, when there is one, and
# builds with `go run` otherwise.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
installed="$repo/scripts/dev-bin/.bin/wuphf-instagram"
cd "$repo/connectors/instagram"

run=(go run ./cmd/wuphf-instagram)
if [ -x "$installed" ]; then
    run=("$installed")
fi

if [ "$#" -gt 0 ]; then
    exec "${run[@]}" "$@"
fi
exec "${run[@]}" -config "${WUPHF_INSTAGRAM_CONFIG:-config.example.toml}"
