#!/usr/bin/env bash
# Run the instagram connector from its own directory, where its session
# and config files live. Config comes from $WUPHF_INSTAGRAM_CONFIG, else
# config.local.toml, else the checked-in example. Any argument switches to
# passthrough, so subcommands still work.
# Runs the binary scripts/install-dev-bins.sh installed, when there is one, and
# builds with `go run` otherwise.
#
# The connector authenticates to the server with the token in
# WUPHF_CONNECTOR_INSTAGRAM_MAIN_TOKEN (its config's core_token_env), which must
# hold the same value the server reads for it.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
. "$repo/scripts/lib/dev-config.sh"
installed="$repo/scripts/dev-bin/.bin/wuphf-instagram"
cd "$repo/connectors/instagram"

run=(go run ./cmd/wuphf-instagram)
if [ -x "$installed" ]; then
    run=("$installed")
fi

# `setup` edits the repo's shared .env.local (this runs from the component's
# directory), unless told otherwise.
if [ "${1:-}" = setup ] && [[ " $* " != *"-env-file"* ]]; then
    exec "${run[@]}" "$@" -env-file "$repo/.env.local"
fi
if [ "$#" -gt 0 ]; then
    exec "${run[@]}" "$@"
fi
exec "${run[@]}" -config "$(dev_config "${WUPHF_INSTAGRAM_CONFIG:-}" config.example.toml)"
