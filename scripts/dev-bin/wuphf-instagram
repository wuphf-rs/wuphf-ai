#!/usr/bin/env bash
# Run the instagram connector from its own directory, where its session and
# config files live. Config comes from $WUPHF_INSTAGRAM_CONFIG, or the checked-in
# example. Any argument switches to passthrough, so subcommands still work.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
cd "$repo/connectors/instagram"

if [ "$#" -gt 0 ]; then
    exec go run ./cmd/wuphf-instagram "$@"
fi
exec go run ./cmd/wuphf-instagram -config "${WUPHF_INSTAGRAM_CONFIG:-config.example.toml}"
