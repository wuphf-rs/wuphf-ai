#!/usr/bin/env bash
# Run wuphf-misc (non-bridging features, e.g. the Instagram downloader)
# from its own directory. Config comes from $WUPHF_MISC_CONFIG, else
# config.local.toml, else the checked-in example. Any argument switches to
# passthrough, so one-off flags still work.
# Runs the binary scripts/install-dev-bins.sh installed, when there is one, and
# builds with `go run` otherwise.
#
# It reads the core's observer token from the variable its config names
# (WUPHF_OBSERVER_TOKEN in the example). The example enables no feature, so
# copy it and enable one first.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
. "$repo/scripts/lib/dev-config.sh"
installed="$repo/scripts/dev-bin/.bin/wuphf-misc"
cd "$repo/misc"

run=(go run ./cmd/wuphf-misc)
if [ -x "$installed" ]; then
    run=("$installed")
fi

# `setup` edits the repo's shared .env.local (this runs from the component's
# directory), unless told otherwise.
if [ "${1:-}" = setup ] && [[ " $* " != *"-env-file"* ]]; then
    exec "${run[@]}" "$@" -env-file "$repo/.env.local"
fi
if [ "$#" -gt 0 ]; then
    exec "${run[@]}" "$@"
fi
exec "${run[@]}" -config "$(dev_config "${WUPHF_MISC_CONFIG:-}" config.example.toml)"
