#!/usr/bin/env bash
# Run wuphf-misc (non-bridging features, e.g. the Instagram downloader) from its
# own directory. Config comes from $WUPHF_MISC_CONFIG, or the checked-in
# example. Any argument switches to passthrough, so one-off flags still work.
# Runs the binary scripts/install-dev-bins.sh installed, when there is one, and
# builds with `go run` otherwise.
#
# It reads the core's observer token from the variable its config names
# (WUPHF_OBSERVER_TOKEN in the example). The example enables no feature, so
# copy it and enable one first.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
installed="$repo/scripts/dev-bin/.bin/wuphf-misc"
cd "$repo/misc"

run=(go run ./cmd/wuphf-misc)
if [ -x "$installed" ]; then
    run=("$installed")
fi

if [ "$#" -gt 0 ]; then
    exec "${run[@]}" "$@"
fi
exec "${run[@]}" -config "${WUPHF_MISC_CONFIG:-config.example.toml}"
