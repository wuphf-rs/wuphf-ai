#!/usr/bin/env bash
# Run the whatsapp-rust connector from its own directory, where its session
# and config files live. Config comes from $WUPHF_WHATSAPP_RUST_CONFIG,
# else config.local.toml, else the checked-in example. Any argument switches
# to passthrough.
# Runs the binary scripts/install-dev-bins.sh installed, when there is one, and
# builds with `cargo run` otherwise. Its whatsapp-rust dependency uses the
# nightly-only portable_simd feature, which RUSTC_BOOTSTRAP lets the dev shell's
# stable compiler accept.
#
# The connector authenticates to the server with the token in
# WUPHF_CONNECTOR_WHATSAPP_RUST_TOKEN (its config's core_token_env), which must
# hold the same value the server reads for it.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
. "$repo/scripts/lib/dev-config.sh"
installed="$repo/scripts/dev-bin/.bin/wuphf-whatsapp-rust"
cd "$repo/connectors/whatsapp-rust"

run=(env RUSTC_BOOTSTRAP=1 cargo run --release --)
if [ -x "$installed" ]; then
    run=("$installed")
fi

# `setup` edits the repo's shared .env.local (this runs from the connector's
# directory), unless told otherwise.
if [ "${1:-}" = setup ] && [[ " $* " != *"-env-file"* ]]; then
    exec "${run[@]}" "$@" --env-file "$repo/.env.local"
fi
if [ "$#" -gt 0 ]; then
    exec "${run[@]}" "$@"
fi
exec "${run[@]}" --config "$(dev_config "${WUPHF_WHATSAPP_RUST_CONFIG:-}" config.example.toml)"
