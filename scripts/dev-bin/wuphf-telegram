#!/usr/bin/env bash
# Run the telegram connector from its own directory, where its session and
# config files live. Config comes from $WUPHF_TELEGRAM_CONFIG, or the checked-in
# example. Any argument switches to passthrough, so subcommands still work.
# Runs the binary scripts/install-dev-bins.sh installed, when there is one, and
# builds with `go run` otherwise.
#
# The connector authenticates to the server with the token in
# WUPHF_CONNECTOR_TELEGRAM_MAIN_TOKEN (its config's core_token_env), which must
# hold the same value the server reads for it.
set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
installed="$repo/scripts/dev-bin/.bin/wuphf-telegram"
cd "$repo/connectors/telegram"

run=(go run ./cmd/wuphf-telegram)
if [ -x "$installed" ]; then
    run=("$installed")
fi

if [ "$#" -gt 0 ]; then
    exec "${run[@]}" "$@"
fi
exec "${run[@]}" -config "${WUPHF_TELEGRAM_CONFIG:-config.example.toml}"
