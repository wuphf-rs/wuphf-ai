# The WhatsApp connector on whatsapp-rust (opt-in). First pairing is interactive:
# see README.md.
#
# /etc/wuphf/whatsapp-rust.toml
#     the config (see connectors/whatsapp-rust/config.example.toml)
# /etc/wuphf/whatsapp-rust.env
#     this part's token (the variable its config names), with
#     the same value as in /etc/wuphf/core.env
# /var/lib/wuphf/whatsapp-rust
#     working directory: relative session paths in the
#     config live here
[Unit]
Description=wuphf WhatsApp connector (whatsapp-rust)
Documentation=https://github.com/wuphf-rs/wuphf-ai/tree/main/deploy/systemd
After=network-online.target wuphf-core.service
Wants=network-online.target
PartOf=wuphf.target

[Service]
Type=simple
User=wuphf
Group=wuphf
EnvironmentFile=/etc/wuphf/whatsapp-rust.env
StateDirectory=wuphf/whatsapp-rust
StateDirectoryMode=0750
WorkingDirectory=%S/wuphf/whatsapp-rust
ExecStart=/usr/local/bin/wuphf-whatsapp-rust --config /etc/wuphf/whatsapp-rust.toml
# The connector reconnects to the core by itself; this restarts it when the
# process exits with an error.
Restart=on-failure
RestartSec=5s
# It shuts down cleanly (saving its session) on SIGINT, not on SIGTERM.
KillSignal=SIGINT
TimeoutStopSec=30s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=wuphf.target
