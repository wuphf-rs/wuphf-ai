# /etc/wuphf/core.env (mode 0600, owner root): read by systemd, not by the
# wuphf user. The core needs every token its config names; each value must
# equal the one in that part's own env file. Generate each with
#   openssl rand -hex 32
WUPHF_CONNECTOR_TELEGRAM_MAIN_TOKEN=
WUPHF_CONNECTOR_WHATSAPP_MAIN_TOKEN=
WUPHF_CONNECTOR_INSTAGRAM_MAIN_TOKEN=
# Only when core.toml has the whatsapp-rust [[connectors]] entry:
# WUPHF_CONNECTOR_WHATSAPP_RUST_TOKEN=
WUPHF_PROVIDER_MEDIACONV_TOKEN=
# Only with the instagram-main [[functions.providers]] entry:
# WUPHF_PROVIDER_INSTAGRAM_TOKEN=
# The observer token (overrides observer_token in core.toml). The TUI and
# wuphf-misc present it; misc.env holds the same value.
# WUPHF_CORE_OBSERVER_TOKEN=
# WUPHF_LOG_LEVEL=info
