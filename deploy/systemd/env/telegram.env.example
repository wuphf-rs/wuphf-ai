# /etc/wuphf/telegram.env (mode 0600, owner root)
WUPHF_CONNECTOR_TELEGRAM_MAIN_TOKEN=
# Telegram application credentials (https://my.telegram.org).
WUPHF_TELEGRAM_APP_ID=
WUPHF_TELEGRAM_APP_HASH=
# Either a bot session...
WUPHF_TELEGRAM_BOT_TOKEN=
# ...or a user session (log in once interactively first, see README.md):
# WUPHF_TELEGRAM_PHONE=
# WUPHF_TELEGRAM_PASSWORD=
# Helper bot for a user session's settings panel:
# WUPHF_TELEGRAM_PANEL_BOT_TOKEN=
