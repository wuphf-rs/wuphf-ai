# deploy/docker/.env: read by `docker compose` (not by wuphf). Copy it to .env.

# The release to run (an image tag: 0.2.0, 0.2 or latest).
WUPHF_VERSION=latest

# The parts next to the core, comma-separated: telegram, whatsapp,
# whatsapp-rust, instagram, mediaconv, misc.
COMPOSE_PROFILES=telegram,whatsapp,mediaconv

# Every part runs as this user, which owns its state and the files setup
# writes into config/: your own (`id -u`, `id -g`).
PUID=1000
PGID=1000

# The core's port on this host's loopback (wuphf-tui, `settings reload`).
# WUPHF_CORE_PORT=50051

# Where the configs and every part's data live on this host.
# WUPHF_CONFIG=./config
# WUPHF_DATA=./data
